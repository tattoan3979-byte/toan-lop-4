<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bé Học Toán Lớp 2 - Mini App</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & ReactDOM CDN -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel for JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Framer Motion CDN -->
    <script src="https://unpkg.com/framer-motion@10.16.4/dist/framer-motion.js"></script>
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Quicksand', sans-serif;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .cursor-blink {
            display: inline-block;
            width: 4px;
            height: 1em;
            background-color: #60a5fa;
            margin-left: 4px;
            animation: blink 0.8s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .bg-pattern {
            background-image: radial-gradient(#bfdbfe 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>
<body class="bg-blue-50 bg-pattern">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useCallback, useRef } = React;
        const { motion, AnimatePresence } = FramerMotion;

        // Icon Wrapper Component for Lucide
        const Icon = ({ name, className, fill = "none" }) => {
            const iconRef = useRef(null);
            useEffect(() => {
                if (iconRef.current) {
                    lucide.createIcons({
                        attrs: { class: className, fill: fill },
                        nameAttr: 'data-lucide',
                        icons: { [name]: lucide.icons[name] }
                    });
                }
            }, [name, className, fill]);
            return <i data-lucide={name} ref={iconRef} className={className}></i>;
        };

        const ANIMAL_ICONS = [
            { id: 'cat', icon: 'Cat', color: 'text-orange-400', bg: 'bg-orange-100' },
            { id: 'dog', icon: 'Dog', color: 'text-amber-600', bg: 'bg-amber-100' },
            { id: 'bird', icon: 'Bird', color: 'text-blue-400', bg: 'bg-blue-100' },
            { id: 'fish', icon: 'Fish', color: 'text-cyan-400', bg: 'bg-cyan-100' },
            { id: 'rabbit', icon: 'Rabbit', color: 'text-pink-400', bg: 'bg-pink-100' },
            { id: 'turtle', icon: 'Turtle', color: 'text-green-500', bg: 'bg-green-100' },
        ];

        function App() {
            const [gameState, setGameState] = useState('START');
            const [gameMode, setGameMode] = useState('ENDLESS');
            const [playerName, setPlayerName] = useState('');
            const [selectedIcon, setSelectedIcon] = useState(ANIMAL_ICONS[0]);
            const [question, setQuestion] = useState(null);
            const [userInput, setUserInput] = useState('');
            const [score, setScore] = useState(0);
            const [timeLeft, setTimeLeft] = useState(30);
            const [feedback, setFeedback] = useState(null);
            const [streak, setStreak] = useState(0);
            const [quizIndex, setQuizIndex] = useState(0);
            const [quizCorrectCount, setQuizCorrectCount] = useState(0);
            const timerRef = useRef(null);

            const generateQuestion = useCallback(() => {
                const types = ['MATH', 'MATH', 'MATH', 'COMPARE'];
                const type = types[Math.floor(Math.random() * types.length)];
                
                if (type === 'COMPARE') {
                    const n1 = Math.floor(Math.random() * 100);
                    const n2 = Math.floor(Math.random() * 100);
                    const ans = n1 > n2 ? '>' : n1 < n2 ? '<' : '=';
                    setQuestion({ type: 'COMPARE', num1: n1, num2: n2, operator: '?', answer: ans, options: ['<', '=', '>'] });
                } else {
                    const ops = ['+', '-', '×', '÷'];
                    const operator = ops[Math.floor(Math.random() * ops.length)];
                    let n1, n2, ans;

                    if (operator === '+') {
                        n1 = Math.floor(Math.random() * 90) + 1;
                        n2 = Math.floor(Math.random() * (100 - n1)) + 1;
                        ans = n1 + n2;
                    } else if (operator === '-') {
                        n1 = Math.floor(Math.random() * 99) + 2;
                        n2 = Math.floor(Math.random() * n1) + 1;
                        ans = n1 - n2;
                    } else if (operator === '×') {
                        const tables = [2, 3, 4, 5, 10];
                        n1 = tables[Math.floor(Math.random() * tables.length)];
                        n2 = Math.floor(Math.random() * 10) + 1;
                        ans = n1 * n2;
                    } else {
                        const tables = [2, 3, 4, 5, 10];
                        n2 = tables[Math.floor(Math.random() * tables.length)];
                        ans = Math.floor(Math.random() * 10) + 1;
                        n1 = n2 * ans;
                    }

                    const q = { type: 'MATH', num1: n1, num2: n2, operator, answer: ans };
                    
                    if (gameMode === 'QUIZ_10') {
                        const options = new Set();
                        options.add(ans.toString());
                        while (options.size < 4) {
                            const offset = Math.floor(Math.random() * 11) - 5;
                            const distractor = Math.max(0, ans + offset);
                            options.add(distractor.toString());
                        }
                        q.options = Array.from(options).sort((a, b) => parseInt(a) - parseInt(b));
                    }
                    setQuestion(q);
                }

                setUserInput('');
                setTimeLeft(30);
                setFeedback(null);
            }, [gameMode]);

            const startMode = (mode) => {
                setGameMode(mode);
                setScore(0);
                setStreak(0);
                setQuizIndex(0);
                setQuizCorrectCount(0);
                setGameState(mode === 'ENDLESS' ? 'PLAYING' : 'QUIZ');
                setTimeout(generateQuestion, 100);
            };

            const handleAnswer = useCallback((val) => {
                if (!question || feedback) return;

                const isCorrect = val === question.answer.toString();
                
                if (isCorrect) {
                    setFeedback('CORRECT');
                    if (gameMode === 'ENDLESS') {
                        setScore(s => s + 10 + Math.floor(timeLeft / 3));
                        setStreak(s => s + 1);
                    } else {
                        setQuizCorrectCount(c => c + 1);
                    }
                    
                    confetti({
                        particleCount: 150,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: ['#FFD700', '#FF4500', '#1E90FF', '#32CD32']
                    });
                } else {
                    setFeedback('WRONG');
                    setStreak(0);
                }

                setTimeout(() => {
                    if (gameMode === 'QUIZ_10') {
                        if (quizIndex < 9) {
                            setQuizIndex(i => i + 1);
                            generateQuestion();
                        } else {
                            setScore(quizCorrectCount * 10 + (isCorrect ? 10 : 0));
                            setGameState('RESULT');
                        }
                    } else {
                        generateQuestion();
                    }
                }, 1500);
            }, [question, feedback, timeLeft, generateQuestion, gameMode, quizIndex, quizCorrectCount]);

            useEffect(() => {
                if ((gameState === 'PLAYING' || gameState === 'QUIZ') && timeLeft > 0 && !feedback) {
                    timerRef.current = setInterval(() => {
                        setTimeLeft(t => {
                            if (t <= 1) {
                                if (gameMode === 'ENDLESS') {
                                    setGameState('RESULT');
                                } else {
                                    handleAnswer('TIMEOUT');
                                }
                                return 0;
                            }
                            return t - 1;
                        });
                    }, 1000);
                }
                return () => clearInterval(timerRef.current);
            }, [gameState, feedback, timeLeft, gameMode, handleAnswer]);

            useEffect(() => {
                const handleKeyDown = (e) => {
                    if ((gameState !== 'PLAYING' && gameState !== 'QUIZ') || feedback || !question) return;
                    if (question.options) return;

                    if (e.key >= '0' && e.key <= '9') {
                        if (userInput.length < 3) setUserInput(prev => prev + e.key);
                    } else if (e.key === 'Backspace') {
                        setUserInput(prev => prev.slice(0, -1));
                    } else if (e.key === 'Enter' && userInput !== '') {
                        handleAnswer(userInput);
                    }
                };
                window.addEventListener('keydown', handleKeyDown);
                return () => window.removeEventListener('keydown', handleKeyDown);
            }, [gameState, feedback, question, userInput, handleAnswer]);

            return (
                <div className="min-h-screen bg-gradient-to-b from-blue-100 to-purple-100 p-4 flex flex-col items-center justify-center">
                    <AnimatePresence mode="wait">
                        {gameState === 'START' && (
                            <motion.div key="start" initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, scale: 0.9 }} className="text-center space-y-8">
                                <motion.div animate={{ rotate: [0, 5, -5, 0] }} transition={{ repeat: Infinity, duration: 4 }}>
                                    <Icon name="Star" className="w-24 h-24 text-yellow-400 mx-auto drop-shadow-xl" fill="currentColor" />
                                </motion.div>
                                <h1 className="text-5xl font-black text-blue-600 mt-4 tracking-tight drop-shadow-sm">BÉ HỌC TOÁN</h1>
                                <p className="text-blue-500 font-medium text-xl">Lớp 2: Cộng, Trừ, Nhân, Chia</p>
                                <motion.button whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.95 }} onClick={() => setGameState('SETUP')} className="bg-orange-500 hover:bg-orange-600 text-white px-12 py-5 rounded-full text-3xl font-bold shadow-2xl flex items-center gap-3 mx-auto transition-colors">
                                    <Icon name="Play" className="w-8 h-8" fill="currentColor" /> BẮT ĐẦU
                                </motion.button>
                            </motion.div>
                        )}

                        {gameState === 'SETUP' && (
                            <motion.div key="setup" initial={{ opacity: 0, x: 50 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0, x: -50 }} className="w-full max-w-md bg-white rounded-[3rem] p-8 shadow-2xl border-4 border-blue-200 text-center space-y-6">
                                <h2 className="text-3xl font-black text-blue-600">Bé tên là gì nhỉ?</h2>
                                <div className="relative">
                                    <Icon name="User" className="absolute left-4 top-1/2 -translate-y-1/2 text-blue-300 w-6 h-6" />
                                    <input type="text" value={playerName} onChange={(e) => setPlayerName(e.target.value)} placeholder="Nhập tên của bé..." className="w-full pl-12 pr-4 py-4 bg-blue-50 border-2 border-blue-100 rounded-2xl text-xl font-bold text-blue-700 focus:outline-none focus:border-blue-400 transition-colors" maxLength={15} />
                                </div>
                                <div className="space-y-4">
                                    <p className="text-gray-500 font-bold">Chọn một người bạn đồng hành:</p>
                                    <div className="grid grid-cols-3 gap-4">
                                        {ANIMAL_ICONS.map((item) => (
                                            <motion.button key={item.id} whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }} onClick={() => setSelectedIcon(item)} className={`p-4 rounded-2xl flex flex-col items-center gap-2 transition-all border-4 ${selectedIcon.id === item.id ? 'border-blue-400 bg-blue-50' : 'border-transparent bg-gray-50'}`}>
                                                <Icon name={item.icon} className={`w-10 h-10 ${item.color}`} />
                                            </motion.button>
                                        ))}
                                    </div>
                                </div>
                                <button onClick={() => setGameState('MODE_SELECT')} disabled={!playerName.trim()} className={`w-full py-4 rounded-2xl text-2xl font-black shadow-lg transition-all ${playerName.trim() ? 'bg-green-500 text-white hover:bg-green-600' : 'bg-gray-200 text-gray-400 cursor-not-allowed'}`}>TIẾP TỤC</button>
                            </motion.div>
                        )}

                        {gameState === 'MODE_SELECT' && (
                            <motion.div key="mode_select" initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="w-full max-w-md bg-white rounded-[3rem] p-8 shadow-2xl border-4 border-blue-200 text-center space-y-8">
                                <h2 className="text-3xl font-black text-blue-600">Chọn chế độ chơi</h2>
                                <div className="grid grid-cols-1 gap-6">
                                    <motion.button whileHover={{ scale: 1.02 }} whileTap={{ scale: 0.98 }} onClick={() => startMode('ENDLESS')} className="p-6 bg-blue-50 border-4 border-blue-100 rounded-3xl text-left flex items-center gap-6 hover:border-blue-400 transition-all">
                                        <div className="bg-blue-500 p-4 rounded-2xl text-white"><Icon name="Zap" className="w-8 h-8" /></div>
                                        <div><h3 className="text-2xl font-black text-blue-700">Luyện tập</h3><p className="text-blue-400 font-bold">Vô hạn câu hỏi, đếm điểm</p></div>
                                    </motion.button>
                                    <motion.button whileHover={{ scale: 1.02 }} whileTap={{ scale: 0.98 }} onClick={() => startMode('QUIZ_10')} className="p-6 bg-purple-50 border-4 border-purple-100 rounded-3xl text-left flex items-center gap-6 hover:border-purple-400 transition-all">
                                        <div className="bg-purple-500 p-4 rounded-2xl text-white"><Icon name="BookOpen" className="w-8 h-8" /></div>
                                        <div><h3 className="text-2xl font-black text-purple-700">Kiểm tra</h3><p className="text-purple-400 font-bold">10 câu trắc nghiệm A/B/C/D</p></div>
                                    </motion.button>
                                </div>
                                <button onClick={() => setGameState('SETUP')} className="text-gray-400 font-bold flex items-center gap-2 mx-auto"><Icon name="ChevronLeft" className="w-5 h-5" /> Quay lại</button>
                            </motion.div>
                        )}

                        {(gameState === 'PLAYING' || gameState === 'QUIZ') && question && (
                            <motion.div key="playing" initial={{ opacity: 0, scale: 1.1 }} animate={{ opacity: 1, scale: 1 }} className="w-full max-w-md bg-white/90 backdrop-blur-md rounded-[3rem] p-8 shadow-2xl border-4 border-blue-200 relative">
                                <div className="flex justify-between items-center mb-10">
                                    <div className="flex items-center gap-3">
                                        <div className={`p-2 rounded-xl ${selectedIcon.bg}`}><Icon name={selectedIcon.icon} className={`w-8 h-8 ${selectedIcon.color}`} /></div>
                                        <div className="text-left"><p className="text-xs font-bold text-gray-400 uppercase tracking-widest">{gameMode === 'QUIZ_10' ? `Câu ${quizIndex + 1}/10` : 'Người chơi'}</p><p className="text-lg font-black text-blue-600 leading-none">{playerName}</p></div>
                                    </div>
                                    <div className="flex gap-2">
                                        <div className="flex items-center gap-2 bg-blue-100 px-4 py-2 rounded-full"><Icon name="Timer" className={`w-6 h-6 ${timeLeft < 10 ? 'text-red-500 animate-pulse' : 'text-blue-500'}`} /><span className={`text-2xl font-black ${timeLeft < 10 ? 'text-red-500' : 'text-blue-700'}`}>{timeLeft}s</span></div>
                                        {gameMode === 'ENDLESS' && <div className="flex items-center gap-2 bg-yellow-100 px-4 py-2 rounded-full"><Icon name="Trophy" className="w-6 h-6 text-yellow-600" /><span className="text-2xl font-black text-yellow-700">{score}</span></div>}
                                    </div>
                                </div>

                                <div className="text-center mb-8">
                                    <div className="text-6xl font-black text-gray-800 flex items-center justify-center gap-4">
                                        {question.type === 'COMPARE' ? (<><span>{question.num1}</span><span className="text-blue-500">?</span><span>{question.num2}</span></>) : (<><span>{question.num1}</span><span className="text-blue-500">{question.operator}</span><span>{question.num2}</span><span className="text-gray-400">=</span></>)}
                                    </div>
                                    {question.type === 'MATH' && !question.options && (
                                        <div className="mt-6 h-24 flex flex-col items-center justify-center">
                                            <div className={`text-6xl font-black border-b-8 min-w-[140px] pb-2 transition-colors flex items-center justify-center ${feedback === 'CORRECT' ? 'text-green-500 border-green-500' : feedback === 'WRONG' ? 'text-red-500 border-red-500' : 'text-blue-600 border-blue-200'}`}>
                                                {userInput || '?'}{!feedback && <span className="cursor-blink"></span>}
                                            </div>
                                            <p className="text-gray-400 font-bold mt-4 animate-bounce">Nhấn phím số & Enter</p>
                                        </div>
                                    )}
                                </div>

                                {question.options && (
                                    <div className="grid grid-cols-2 gap-4 mt-8">
                                        {question.options.map((opt, idx) => (
                                            <motion.button key={idx} whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.95 }} onClick={() => handleAnswer(opt)} className="bg-white border-4 border-blue-100 hover:border-blue-400 p-6 rounded-3xl text-3xl font-black text-blue-600 shadow-lg transition-all flex items-center justify-center gap-2">
                                                {question.type === 'COMPARE' ? (opt === '>' ? <Icon name="ChevronRight" className="w-8 h-8" /> : opt === '<' ? <Icon name="ChevronLeft" className="w-8 h-8" /> : <Icon name="Equal" className="w-8 h-8" />) : opt}
                                            </motion.button>
                                        ))}
                                    </div>
                                )}

                                <AnimatePresence>
                                    {feedback && (
                                        <motion.div initial={{ opacity: 0, scale: 0.5 }} animate={{ opacity: 1, scale: 1 }} exit={{ opacity: 0 }} className="absolute inset-0 flex items-center justify-center bg-white/60 rounded-[3rem] z-10 backdrop-blur-sm">
                                            {feedback === 'CORRECT' ? (
                                                <div className="text-center"><Icon name="CheckCircle2" className="w-32 h-32 text-green-500 mx-auto" /><p className="text-3xl font-black text-green-600 mt-2">CHÍNH XÁC!</p></div>
                                            ) : (
                                                <div className="text-center"><Icon name="XCircle" className="w-32 h-32 text-red-500 mx-auto" /><p className="text-3xl font-black text-red-600 mt-2">SAI RỒI!</p><p className="text-xl font-bold text-gray-600">Đáp án là {question.answer}</p></div>
                                            )}
                                        </motion.div>
                                    )}
                                </AnimatePresence>

                                {streak > 1 && <motion.div initial={{ x: 50, opacity: 0 }} animate={{ x: 0, opacity: 1 }} className="absolute -right-4 top-1/2 bg-yellow-400 text-white px-4 py-2 rounded-l-full font-black shadow-lg">COMBO x{streak} 🔥</motion.div>}
                            </motion.div>
                        )}

                        {gameState === 'RESULT' && (
                            <motion.div key="result" initial={{ opacity: 0, scale: 0.8 }} animate={{ opacity: 1, scale: 1 }} className="text-center space-y-8 bg-white p-12 rounded-[3rem] shadow-2xl border-4 border-yellow-200 w-full max-w-md">
                                <div className="relative inline-block">
                                    <Icon name="Trophy" className="w-32 h-32 text-yellow-400 mx-auto drop-shadow-xl" fill="currentColor" />
                                    <div className={`absolute -bottom-2 -right-2 p-3 rounded-2xl shadow-lg border-4 border-white ${selectedIcon.bg}`}><Icon name={selectedIcon.icon} className={`w-10 h-10 ${selectedIcon.color}`} /></div>
                                </div>
                                <div>
                                    <h2 className="text-3xl font-black text-gray-800 uppercase tracking-tight">GIỎI QUÁ, {playerName}!</h2>
                                    <p className="text-7xl font-black text-blue-600 mt-4">{gameMode === 'QUIZ_10' ? `${quizCorrectCount}/10` : score}</p>
                                    <p className="text-xl text-gray-500 font-bold uppercase tracking-widest">{gameMode === 'QUIZ_10' ? 'Số câu đúng' : 'Điểm của bé'}</p>
                                </div>
                                <div className="flex gap-4">
                                    <button onClick={() => startMode(gameMode)} className="bg-blue-500 hover:bg-blue-600 text-white px-8 py-4 rounded-full text-xl font-bold flex items-center gap-2 shadow-lg transition-colors flex-1 justify-center"><Icon name="RotateCcw" className="w-6 h-6" /> CHƠI LẠI</button>
                                    <button onClick={() => setGameState('START')} className="bg-gray-200 hover:bg-gray-300 text-gray-700 px-8 py-4 rounded-full text-xl font-bold shadow-lg transition-colors flex-1 justify-center">TRANG CHỦ</button>
                                </div>
                            </motion.div>
                        )}
                    </AnimatePresence>

                    <div className="fixed top-0 left-0 w-full h-full pointer-events-none -z-10 opacity-30">
                        <div className="absolute top-10 left-10 w-20 h-20 bg-yellow-300 rounded-full blur-3xl" />
                        <div className="absolute bottom-20 right-10 w-32 h-32 bg-blue-300 rounded-full blur-3xl" />
                        <div className="absolute top-1/2 left-1/4 w-40 h-40 bg-purple-300 rounded-full blur-3xl" />
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
