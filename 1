<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bé Học Toán Lớp 2 - Cùng Bạn Nhỏ Thông Thái</title>
    <!-- Thư viện React & Babel để chạy JSX ngay trên trình duyệt -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Confetti (Pháo hoa) -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Quicksand', sans-serif; }
        .math-shadow { text-shadow: 4px 4px 0px rgba(0,0,0,0.1); }
        .btn-pop:active { transform: scale(0.95); }
        @keyframes bounce-slow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
        .animate-bounce-slow { animation: bounce-slow 2s infinite; }
    </style>
</head>
<body class="bg-blue-50">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useCallback, useRef } = React;

        // Định nghĩa các Icon bằng SVG để không phụ thuộc thư viện ngoài
        const Icons = {
            Star: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>,
            Play: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>,
            Trophy: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>,
            Timer: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>,
            RotateCcw: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>,
            Check: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="20 6 9 17 4 12"/></svg>,
            X: () => <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        };

        const ANIMAL_ICONS = [
            { id: 'cat', label: '🐱', color: 'bg-orange-100 text-orange-500' },
            { id: 'dog', label: '🐶', color: 'bg-amber-100 text-amber-600' },
            { id: 'bird', label: '🐦', color: 'bg-blue-100 text-blue-500' },
            { id: 'rabbit', label: '🐰', color: 'bg-pink-100 text-pink-500' },
            { id: 'turtle', label: '🐢', color: 'bg-green-100 text-green-600' },
            { id: 'lion', label: '🦁', color: 'bg-yellow-100 text-yellow-600' },
        ];

        function App() {
            const [gameState, setGameState] = useState('START'); // START, SETUP, MODE, PLAYING, RESULT
            const [gameMode, setGameMode] = useState('ENDLESS'); // ENDLESS, QUIZ
            const [playerName, setPlayerName] = useState('');
            const [selectedIcon, setSelectedIcon] = useState(ANIMAL_ICONS[0]);
            const [question, setQuestion] = useState(null);
            const [userInput, setUserInput] = useState('');
            const [score, setScore] = useState(0);
            const [timeLeft, setTimeLeft] = useState(30);
            const [feedback, setFeedback] = useState(null); // CORRECT, WRONG
            const [quizIndex, setQuizIndex] = useState(0);
            const [quizCorrect, setQuizCorrect] = useState(0);
            const timerRef = useRef(null);

            const generateQuestion = useCallback(() => {
                const types = ['MATH', 'MATH', 'COMPARE'];
                const type = types[Math.floor(Math.random() * types.length)];
                
                if (type === 'COMPARE') {
                    const n1 = Math.floor(Math.random() * 50);
                    const n2 = Math.floor(Math.random() * 50);
                    const ans = n1 > n2 ? '>' : n1 < n2 ? '<' : '=';
                    setQuestion({ type: 'COMPARE', n1, n2, op: '?', ans, options: ['<', '=', '>'] });
                } else {
                    const ops = ['+', '-', '×'];
                    const op = ops[Math.floor(Math.random() * ops.length)];
                    let n1, n2, ans;

                    if (op === '+') {
                        n1 = Math.floor(Math.random() * 50) + 1;
                        n2 = Math.floor(Math.random() * 49) + 1;
                        ans = n1 + n2;
                    } else if (op === '-') {
                        n1 = Math.floor(Math.random() * 80) + 20;
                        n2 = Math.floor(Math.random() * n1);
                        ans = n1 - n2;
                    } else {
                        const tables = [2, 3, 4, 5, 10];
                        n1 = tables[Math.floor(Math.random() * tables.length)];
                        n2 = Math.floor(Math.random() * 10) + 1;
                        ans = n1 * n2;
                    }

                    const q = { type: 'MATH', n1, n2, op, ans };
                    if (gameMode === 'QUIZ') {
                        const opts = new Set([ans.toString()]);
                        while(opts.size < 4) {
                            const offset = Math.floor(Math.random() * 10) - 5;
                            opts.add(Math.max(0, ans + offset).toString());
                        }
                        q.options = Array.from(opts).sort((a, b) => a - b);
                    }
                    setQuestion(q);
                }
                setUserInput('');
                setTimeLeft(20);
                setFeedback(null);
            }, [gameMode]);

            const handleAnswer = (val) => {
                if (feedback) return;
                const isCorrect = val.toString() === question.ans.toString();
                
                if (isCorrect) {
                    setFeedback('CORRECT');
                    if (gameMode === 'ENDLESS') setScore(s => s + 10);
                    else setQuizCorrect(c => c + 1);
                    confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                } else {
                    setFeedback('WRONG');
                }

                setTimeout(() => {
                    if (gameMode === 'QUIZ') {
                        if (quizIndex < 9) {
                            setQuizIndex(i => i + 1);
                            generateQuestion();
                        } else {
                            setGameState('RESULT');
                        }
                    } else {
                        generateQuestion();
                    }
                }, 1500);
            };

            useEffect(() => {
                if (gameState === 'PLAYING' && timeLeft > 0 && !feedback) {
                    timerRef.current = setInterval(() => setTimeLeft(t => t - 1), 1000);
                } else if (timeLeft === 0 && gameState === 'PLAYING') {
                    if (gameMode === 'ENDLESS') setGameState('RESULT');
                    else handleAnswer('TIMEOUT');
                }
                return () => clearInterval(timerRef.current);
            }, [gameState, timeLeft, feedback]);

            // Xử lý bàn phím
            useEffect(() => {
                const onKey = (e) => {
                    if (gameState !== 'PLAYING' || feedback || question?.options) return;
                    if (e.key >= '0' && e.key <= '9') setUserInput(p => (p + e.key).slice(0, 3));
                    if (e.key === 'Backspace') setUserInput(p => p.slice(0, -1));
                    if (e.key === 'Enter' && userInput) handleAnswer(userInput);
                };
                window.addEventListener('keydown', onKey);
                return () => window.removeEventListener('keydown', onKey);
            }, [gameState, feedback, userInput, question]);

            return (
                <div className="min-h-screen flex flex-col items-center justify-center p-4">
                    {/* MÀN HÌNH CHÀO */}
                    {gameState === 'START' && (
                        <div className="text-center space-y-8">
                            <div className="animate-bounce-slow">
                                <div className="bg-yellow-400 p-6 rounded-full inline-block shadow-xl">
                                    <Icons.Star />
                                </div>
                            </div>
                            <h1 className="text-5xl font-black text-blue-600 tracking-tight math-shadow">BÉ HỌC TOÁN</h1>
                            <p className="text-blue-400 font-bold text-xl">Lớp 2: Cộng, Trừ & Nhân Chia</p>
                            <button 
                                onClick={() => setGameState('SETUP')}
                                class="bg-orange-500 hover:bg-orange-600 text-white px-12 py-5 rounded-full text-3xl font-bold shadow-2xl transition-all btn-pop flex items-center gap-3 mx-auto"
                            >
                                <Icons.Play /> BẮT ĐẦU
                            </button>
                        </div>
                    )}

                    {/* CÀI ĐẶT TÊN & ICON */}
                    {gameState === 'SETUP' && (
                        <div className="bg-white p-8 rounded-[2rem] shadow-2xl w-full max-w-md border-4 border-blue-100 text-center space-y-6">
                            <h2 className="text-2xl font-bold text-blue-600">Bé tên là gì nhỉ?</h2>
                            <input 
                                type="text" 
                                value={playerName}
                                onChange={e => setPlayerName(e.target.value)}
                                placeholder="Nhập tên của bé..."
                                className="w-full p-4 bg-blue-50 rounded-xl border-2 border-blue-200 text-xl font-bold text-center focus:outline-none focus:border-blue-400"
                            />
                            <div className="grid grid-cols-3 gap-3">
                                {ANIMAL_ICONS.map(icon => (
                                    <button 
                                        key={icon.id}
                                        onClick={() => setSelectedIcon(icon)}
                                        className={`text-3xl p-4 rounded-xl transition-all ${selectedIcon.id === icon.id ? 'ring-4 ring-blue-400 scale-110' : 'opacity-50'} ${icon.color}`}
                                    >
                                        {icon.label}
                                    </button>
                                ))}
                            </div>
                            <button 
                                disabled={!playerName}
                                onClick={() => setGameState('MODE')}
                                className={`w-full py-4 rounded-xl text-xl font-bold text-white shadow-lg ${playerName ? 'bg-green-500' : 'bg-gray-300'}`}
                            >
                                TIẾP TỤC
                            </button>
                        </div>
                    )}

                    {/* CHỌN CHẾ ĐỘ */}
                    {gameState === 'MODE' && (
                        <div className="space-y-6 w-full max-w-md">
                            <h2 className="text-3xl font-black text-center text-blue-600">Chọn chế độ chơi</h2>
                            <button onClick={() => { setGameMode('ENDLESS'); setGameState('PLAYING'); setScore(0); generateQuestion(); }} className="w-full p-6 bg-white rounded-2xl shadow-xl border-4 border-blue-100 flex items-center gap-4 hover:border-blue-400 transition-all">
                                <div className="bg-blue-500 text-white p-3 rounded-lg"><Icons.Star /></div>
                                <div className="text-left"><b className="text-xl block">Luyện tập</b><span className="text-gray-400">Vô hạn câu hỏi, tính điểm</span></div>
                            </button>
                            <button onClick={() => { setGameMode('QUIZ'); setGameState('PLAYING'); setQuizIndex(0); setQuizCorrect(0); generateQuestion(); }} className="w-full p-6 bg-white rounded-2xl shadow-xl border-4 border-purple-100 flex items-center gap-4 hover:border-purple-400 transition-all">
                                <div className="bg-purple-500 text-white p-3 rounded-lg"><Icons.Trophy /></div>
                                <div className="text-left"><b className="text-xl block">Kiểm tra</b><span className="text-gray-400">10 câu trắc nghiệm A/B/C/D</span></div>
                            </button>
                        </div>
                    )}

                    {/* MÀN HÌNH CHƠI */}
                    {gameState === 'PLAYING' && question && (
                        <div className="w-full max-w-md bg-white p-8 rounded-[3rem] shadow-2xl border-4 border-blue-100 relative overflow-hidden">
                            <div className="flex justify-between items-center mb-8">
                                <div className="flex items-center gap-2">
                                    <span className={`text-2xl p-2 rounded-lg ${selectedIcon.color}`}>{selectedIcon.label}</span>
                                    <b className="text-blue-600">{playerName}</b>
                                </div>
                                <div className="flex items-center gap-4">
                                    <div className="flex items-center gap-1 text-orange-500 font-bold"><Icons.Timer /> {timeLeft}s</div>
                                    {gameMode === 'ENDLESS' && <div className="font-black text-blue-600 text-xl">{score}</div>}
                                </div>
                            </div>

                            <div className="text-center space-y-8">
                                <div className="text-6xl font-black text-gray-700 tracking-widest flex justify-center items-center gap-4">
                                    <span>{question.n1}</span>
                                    <span className="text-blue-500">{question.op}</span>
                                    <span>{question.n2}</span>
                                    <span className="text-gray-300">=</span>
                                </div>

                                {question.options ? (
                                    <div className="grid grid-cols-2 gap-4">
                                        {question.options.map((opt, i) => (
                                            <button key={i} onClick={() => handleAnswer(opt)} className="bg-blue-50 hover:bg-blue-100 p-6 rounded-2xl text-3xl font-bold text-blue-600 border-2 border-blue-100 transition-all">
                                                {opt}
                                            </button>
                                        ))}
                                    </div>
                                ) : (
                                    <div className="space-y-4">
                                        <div className="text-7xl font-black text-blue-600 border-b-8 border-blue-100 inline-block min-w-[150px] pb-2">
                                            {userInput || '?'}
                                        </div>
                                        <p className="text-gray-400 font-bold">Dùng bàn phím số & Enter</p>
                                    </div>
                                )}
                            </div>

                            {/* Phản hồi Đúng/Sai */}
                            {feedback && (
                                <div className={`absolute inset-0 flex flex-col items-center justify-center bg-white/90 z-20 transition-all`}>
                                    {feedback === 'CORRECT' ? (
                                        <div className="text-green-500 text-center">
                                            <div className="scale-150 mb-4"><Icons.Check /></div>
                                            <b className="text-3xl">CHÍNH XÁC!</b>
                                        </div>
                                    ) : (
                                        <div className="text-red-500 text-center">
                                            <div className="scale-150 mb-4"><Icons.X /></div>
                                            <b className="text-3xl">TIẾC QUÁ!</b>
                                            <p className="text-gray-500 font-bold">Đáp án là: {question.ans}</p>
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    )}

                    {/* KẾT QUẢ */}
                    {gameState === 'RESULT' && (
                        <div className="text-center space-y-8 bg-white p-12 rounded-[3rem] shadow-2xl border-4 border-yellow-200 w-full max-w-md">
                            <div className="text-8xl">🏆</div>
                            <h2 className="text-3xl font-black text-gray-800">GIỎI QUÁ, {playerName.toUpperCase()}!</h2>
                            <div className="text-6xl font-black text-blue-600">
                                {gameMode === 'QUIZ' ? `${quizCorrect}/10` : score}
                            </div>
                            <p className="text-gray-400 font-bold uppercase tracking-widest">
                                {gameMode === 'QUIZ' ? 'Câu đúng' : 'Điểm của bé'}
                            </p>
                            <div className="flex gap-4">
                                <button onClick={() => setGameState('MODE')} className="flex-1 bg-blue-500 text-white p-4 rounded-2xl font-bold flex items-center justify-center gap-2 shadow-lg"><Icons.RotateCcw /> CHƠI LẠI</button>
                                <button onClick={() => setGameState('START')} className="flex-1 bg-gray-100 text-gray-600 p-4 rounded-2xl font-bold shadow-lg">TRANG CHỦ</button>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
